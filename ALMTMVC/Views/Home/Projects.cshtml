@{
    ViewData["Title"] = "Projects";
    ViewData["Description"] =
        "Explore the types of lift installation, maintenance, repair and modernisation projects supported by Almighty Lift Consultants.";
}

<!-- ==========================================
     PAGE BANNER
========================================== -->

<section class="page-banner">

    <h1>Our Projects</h1>

    <p>
        Professional lift solutions for residential, commercial and
        industrial environments.
    </p>

</section>

<!-- ==========================================
     PROJECTS INTRODUCTION
========================================== -->

<section class="projects-section">

    <div class="projects-heading reveal">

        <span class="section-label">Our work</span>

        <h2>Lift Projects Focused on Safety and Reliability</h2>

        <p>
            Almighty Lift Consultants supports clients with lift
            installations, planned maintenance, repairs, modernisation
            and technical assessments. Each project is approached with
            careful planning, professional communication and attention
            to long-term performance.
        </p>

    </div>

    <div class="project-types-grid">

        <article class="project-type-card reveal">

            <div class="project-type-icon">
                <i class="fa-solid fa-building"></i>
            </div>

            <h3>Commercial Buildings</h3>

            <p>
                Lift solutions for offices, retail centres, hotels and
                mixed-use developments.
            </p>

        </article>

        <article class="project-type-card reveal reveal-delay-1">

            <div class="project-type-icon">
                <i class="fa-solid fa-house"></i>
            </div>

            <h3>Residential Properties</h3>

            <p>
                Installation, servicing and upgrade support for apartment
                buildings and residential complexes.
            </p>

        </article>

        <article class="project-type-card reveal reveal-delay-2">

            <div class="project-type-icon">
                <i class="fa-solid fa-industry"></i>
            </div>

            <h3>Industrial Facilities</h3>

            <p>
                Heavy-duty and goods lift support for warehouses,
                factories and operational facilities.
            </p>

        </article>

    </div>

</section>

<!-- ==========================================
     FEATURED PROJECTS
========================================== -->

<section class="featured-projects">

    <div class="section-heading reveal">

        <span class="section-label">Featured work</span>

        <h2>Project Types We Support</h2>

        <p>
            The examples below show the kinds of services we can provide.
            Replace them with verified company projects and photographs
            when available.
        </p>

    </div>

    <div class="projects-grid">

        <article class="project-card reveal">

            <div class="project-image">
                <img src="~/images/project-installation.jpg"
                     asp-append-version="true"
                     alt="Commercial lift installation project" />
            </div>

            <div class="project-content">

                <span class="project-tag">Installation</span>

                <h3>Commercial Lift Installation</h3>

                <p>
                    Planning and installation support for a new passenger
                    lift system in a multi-storey commercial building.
                </p>

                <ul>
                    <li>Passenger lift installation</li>
                    <li>Testing and commissioning support</li>
                    <li>Technical coordination</li>
                </ul>

            </div>

        </article>

        <article class="project-card reveal reveal-delay-1">

            <div class="project-image">
                <img src="~/images/project-modernisation.jpg"
                     asp-append-version="true"
                     alt="Lift modernisation project" />
            </div>

            <div class="project-content">

                <span class="project-tag">Modernisation</span>

                <h3>Residential Lift Upgrade</h3>

                <p>
                    Upgrade planning for an ageing lift system to improve
                    reliability, appearance and operational performance.
                </p>

                <ul>
                    <li>Controller upgrade guidance</li>
                    <li>Door system improvements</li>
                    <li>Interior refurbishment support</li>
                </ul>

            </div>

        </article>

        <article class="project-card reveal reveal-delay-2">

            <div class="project-image">
                <img src="~/images/project-maintenance.jpg"
                     asp-append-version="true"
                     alt="Preventative lift maintenance project" />
            </div>

            <div class="project-content">

                <span class="project-tag">Maintenance</span>

                <h3>Preventative Maintenance Programme</h3>

                <p>
                    Planned servicing support aimed at reducing breakdowns
                    and improving lift availability.
                </p>

                <ul>
                    <li>Routine servicing</li>
                    <li>Performance inspections</li>
                    <li>Maintenance recommendations</li>
                </ul>

            </div>

        </article>

        <article class="project-card reveal">

            <div class="project-image">
                <img src="~/images/project-repairs.jpg"
                     asp-append-version="true"
                     alt="Lift repair project" />
            </div>

            <div class="project-content">

                <span class="project-tag">Repairs</span>

                <h3>Breakdown and Repair Support</h3>

                <p>
                    Fault investigation and repair work intended to restore
                    safe lift operation with minimal disruption.
                </p>

                <ul>
                    <li>Fault diagnosis</li>
                    <li>Component replacement</li>
                    <li>Operational testing</li>
                </ul>

            </div>

        </article>

        <article class="project-card reveal reveal-delay-1">

            <div class="project-image">
                <img src="~/images/project-assessment.jpg"
                     asp-append-version="true"
                     alt="Lift condition assessment" />
            </div>

            <div class="project-content">

                <span class="project-tag">Assessment</span>

                <h3>Lift Condition Assessment</h3>

                <p>
                    Technical assessment to help a client understand the
                    condition, risks and upgrade requirements of a lift.
                </p>

                <ul>
                    <li>Equipment condition review</li>
                    <li>Maintenance observations</li>
                    <li>Upgrade recommendations</li>
                </ul>

            </div>

        </article>

        <article class="project-card reveal reveal-delay-2">

            <div class="project-image">
                <img src="~/images/project-consulting.jpg"
                     asp-append-version="true"
                     alt="Lift consulting project" />
            </div>

            <div class="project-content">

                <span class="project-tag">Consulting</span>

                <h3>New Development Consulting</h3>

                <p>
                    Technical guidance for a development team planning
                    vertical transportation requirements.
                </p>

                <ul>
                    <li>Project requirement review</li>
                    <li>Specification guidance</li>
                    <li>Maintenance planning input</li>
                </ul>

            </div>

        </article>

    </div>

</section>

<!-- ==========================================
     PROJECT PROCESS
========================================== -->

<section class="project-process">

    <div class="section-heading reveal">

        <span class="section-label">Project delivery</span>

        <h2>How We Approach Each Project</h2>

        <p>
            Our structured process helps ensure that every project is
            understood, planned and delivered professionally.
        </p>

    </div>

    <div class="project-process-grid">

        <article class="project-process-step reveal">
            <span>01</span>
            <h3>Initial Consultation</h3>
            <p>
                We discuss the building, equipment and client requirements.
            </p>
        </article>

        <article class="project-process-step reveal reveal-delay-1">
            <span>02</span>
            <h3>Site Assessment</h3>
            <p>
                We inspect the lift or proposed project environment.
            </p>
        </article>

        <article class="project-process-step reveal reveal-delay-2">
            <span>03</span>
            <h3>Project Scope</h3>
            <p>
                We define the proposed work, recommendations and expected
                outcome.
            </p>
        </article>

        <article class="project-process-step reveal reveal-delay-3">
            <span>04</span>
            <h3>Execution</h3>
            <p>
                Approved work is carried out with attention to safety and
                quality.
            </p>
        </article>

        <article class="project-process-step reveal">
            <span>05</span>
            <h3>Testing and Support</h3>
            <p>
                We verify the completed work and provide follow-up support.
            </p>
        </article>

    </div>

</section>

<!-- ==========================================
     CALL TO ACTION
========================================== -->

<section class="cta reveal">

    <h2>Planning a Lift Project?</h2>

    <p>
        Contact Almighty Lift Consultants to discuss installation,
        maintenance, repair, modernisation or consulting requirements.
    </p>

    <a asp-controller="Home"
       asp-action="Contact"
       class="btn">
        Discuss Your Project
    </a>

</section>