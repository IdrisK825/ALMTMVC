@{
    ViewData["Title"] = "About Us";
    ViewData["Description"] =
        "Learn more about Almighty Lift Consultants and our commitment to safe, reliable and professional lift solutions.";
}

<!-- ==========================================
     PAGE BANNER
========================================== -->

<section class="page-banner">

    <h1>About Almighty Lift Consultants</h1>

    <p>
        Delivering dependable lift solutions through technical expertise,
        professional service and a strong commitment to safety.
    </p>

</section>

<!-- ==========================================
     WHO WE ARE
========================================== -->

<section class="about-section">

    <div class="about-grid">

        <div class="about-content reveal">

            <span class="section-label">Who we are</span>

            <h2>Professional Lift Solutions Built on Trust</h2>

            <p>
                Almighty Lift Consultants is a South African company
                providing professional lift installation, maintenance,
                repairs, modernisation, inspections and technical
                consulting services.
            </p>

            <p>
                We support residential, commercial and industrial
                properties with solutions designed to improve safety,
                reliability and long-term lift performance.
            </p>

            <p>
                Our approach is based on clear communication, quality
                workmanship and building lasting relationships with
                clients.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn">
                Speak to Our Team
            </a>

        </div>

        <div class="about-image reveal reveal-delay-1">

            <img src="~/images/website-home-page.jpg"
                 asp-append-version="true"
                 alt="Modern lift installation" />

        </div>

    </div>

</section>

<!-- ==========================================
     MISSION, VISION AND VALUES
========================================== -->

<section class="about-values">

    <div class="section-heading">

        <span class="section-label">Our foundation</span>

        <h2>Mission, Vision and Core Values</h2>

        <p>
            Our work is guided by a commitment to safety, reliability,
            integrity and professional service.
        </p>

    </div>

    <div class="about-values-grid">

        <article class="about-value-card">

            <span class="about-card-number">01</span>

            <h3>Our Mission</h3>

            <p>
                To provide dependable lift services that prioritise safety,
                quality workmanship, technical excellence and customer
                satisfaction.
            </p>

        </article>

        <article class="about-value-card">

            <span class="about-card-number">02</span>

            <h3>Our Vision</h3>

            <p>
                To become a trusted South African lift consultancy known
                for professional service, reliable solutions and lasting
                client partnerships.
            </p>

        </article>

        <article class="about-value-card">

            <span class="about-card-number">03</span>

            <h3>Our Core Values</h3>

            <ul>
                <li>Safety first</li>
                <li>Integrity</li>
                <li>Professionalism</li>
                <li>Customer commitment</li>
                <li>Quality workmanship</li>
                <li>Continuous improvement</li>
            </ul>

        </article>

    </div>

</section>

<!-- ==========================================
     WHY OUR APPROACH MATTERS
========================================== -->

<section class="about-approach">

    <div class="about-approach-content reveal">

        <span class="section-label">Our approach</span>

        <h2>Focused on Safety, Reliability and Long-Term Performance</h2>

        <p>
            Every lift project requires careful planning, technical
            knowledge and dependable after-service support. We work
            closely with clients to understand their requirements and
            recommend practical solutions suited to their buildings.
        </p>

        <div class="about-checklist">

            <div>Safety-conscious project delivery</div>
            <div>Clear and professional communication</div>
            <div>Preventative maintenance planning</div>
            <div>Modernisation and upgrade guidance</div>
            <div>Responsive technical support</div>
            <div>Long-term client relationships</div>

        </div>

    </div>

</section>

<!-- ==========================================
     CALL TO ACTION
========================================== -->

<section class="cta reveal">

    <h2>Looking for a Reliable Lift Partner?</h2>

    <p>
        Contact Almighty Lift Consultants to discuss your lift
        installation, maintenance, repair or modernisation requirements.
    </p>

    <a asp-controller="Home"
       asp-action="Contact"
       class="btn">
        Contact Us
    </a>

</section>