@{
    ViewData["Title"] = "Services";
    ViewData["Description"] =
        "Professional lift installation, maintenance, repairs, modernisation, inspections and consulting services from Almighty Lift Consultants.";
}

<!-- ==========================================
     PAGE BANNER
========================================== -->

<section class="page-banner">

    <h1>Professional Lift Services</h1>

    <p>
        Complete lift solutions for residential, commercial and
        industrial properties across South Africa.
    </p>

</section>

<!-- ==========================================
     SERVICES INTRODUCTION
========================================== -->

<section class="services-section">

    <div class="services-heading reveal">

        <span class="section-label">What we do</span>

        <h2>Complete Lift Solutions From Installation to Support</h2>

        <p>
            Almighty Lift Consultants provides dependable lift services
            designed to improve safety, performance and long-term
            reliability. We work closely with clients to understand their
            building requirements and recommend practical solutions.
        </p>

    </div>

    <div class="services-grid">

        <article class="service-card reveal">

            <div class="service-icon" aria-hidden="true">
                <i class="fa-solid fa-elevator"></i>
            </div>

            <h3>Lift Installation</h3>

            <p>
                Professional installation of passenger, residential,
                commercial and goods lift systems.
            </p>

            <ul>
                <li>New building installations</li>
                <li>Passenger and goods lifts</li>
                <li>Planning and technical guidance</li>
                <li>Testing and commissioning support</li>
            </ul>

        </article>

        <article class="service-card reveal reveal-delay-1">

            <div class="service-icon" aria-hidden="true">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>

            <h3>Preventative Maintenance</h3>

            <p>
                Planned maintenance programmes aimed at reducing
                breakdowns and improving lift performance.
            </p>

            <ul>
                <li>Routine servicing</li>
                <li>Preventative maintenance schedules</li>
                <li>Performance checks</li>
                <li>Maintenance reporting</li>
            </ul>

        </article>

        <article class="service-card reveal reveal-delay-2">

            <div class="service-icon" aria-hidden="true">
                <i class="fa-solid fa-toolbox"></i>
            </div>

            <h3>Lift Repairs</h3>

            <p>
                Professional fault diagnosis and repair services to help
                restore lift operation safely and efficiently.
            </p>

            <ul>
                <li>Breakdown assistance</li>
                <li>Fault finding</li>
                <li>Component replacement</li>
                <li>Operational testing</li>
            </ul>

        </article>

        <article class="service-card reveal">

            <div class="service-icon" aria-hidden="true">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>

            <h3>Lift Modernisation</h3>

            <p>
                Upgrade older lift systems to improve performance,
                safety, appearance and reliability.
            </p>

            <ul>
                <li>Controller upgrades</li>
                <li>Door system improvements</li>
                <li>Interior refurbishment</li>
                <li>Performance enhancements</li>
            </ul>

        </article>

        <article class="service-card reveal reveal-delay-1">

            <div class="service-icon" aria-hidden="true">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>

            <h3>Inspections and Assessments</h3>

            <p>
                Technical assessments that help clients understand the
                condition and requirements of their lift equipment.
            </p>

            <ul>
                <li>Condition assessments</li>
                <li>Safety observations</li>
                <li>Maintenance recommendations</li>
                <li>Upgrade planning</li>
            </ul>

        </article>

        <article class="service-card reveal reveal-delay-2">

            <div class="service-icon" aria-hidden="true">
                <i class="fa-solid fa-user-tie"></i>
            </div>

            <h3>Technical Consulting</h3>

            <p>
                Professional guidance for new developments, upgrades,
                maintenance planning and lift-related decisions.
            </p>

            <ul>
                <li>Project consultation</li>
                <li>Specification guidance</li>
                <li>Maintenance planning</li>
                <li>Modernisation recommendations</li>
            </ul>

        </article>

    </div>

</section>

<!-- ==========================================
     SERVICE PROCESS
========================================== -->

<section class="service-process">

    <div class="section-heading reveal">

        <span class="section-label">How we work</span>

        <h2>A Clear and Professional Service Process</h2>

        <p>
            We follow a structured process to understand the requirement,
            recommend the right solution and support the client throughout
            the project.
        </p>

    </div>

    <div class="service-process-grid">

        <article class="process-step reveal">
            <span>01</span>
            <h3>Consultation</h3>
            <p>
                We discuss your requirements, concerns and expected
                outcome.
            </p>
        </article>

        <article class="process-step reveal reveal-delay-1">
            <span>02</span>
            <h3>Site Assessment</h3>
            <p>
                Our team evaluates the lift, building or proposed project.
            </p>
        </article>

        <article class="process-step reveal reveal-delay-2">
            <span>03</span>
            <h3>Recommendation</h3>
            <p>
                We provide a practical scope of work and suitable solution.
            </p>
        </article>

        <article class="process-step reveal reveal-delay-3">
            <span>04</span>
            <h3>Project Delivery</h3>
            <p>
                The approved work is carried out professionally and safely.
            </p>
        </article>

        <article class="process-step reveal">
            <span>05</span>
            <h3>Testing and Support</h3>
            <p>
                We verify the work and provide ongoing support where needed.
            </p>
        </article>

    </div>

</section>

<!-- ==========================================
     WHY CHOOSE OUR SERVICES
========================================== -->

<section class="service-benefits">

    <div class="service-benefits-grid">

        <div class="service-benefits-content reveal">

            <span class="section-label">Why our services</span>

            <h2>Solutions Focused on Safety and Long-Term Reliability</h2>

            <p>
                Our aim is not only to complete the immediate task, but to
                help clients improve lift reliability, manage maintenance
                requirements and make informed technical decisions.
            </p>

            <div class="service-benefit-list">

                <div>
                    <i class="fa-solid fa-check"></i>
                    Safety-conscious workmanship
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    Professional communication
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    Practical technical recommendations
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    Responsive customer support
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    Maintenance-focused solutions
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    Long-term client relationships
                </div>

            </div>

        </div>

        <div class="service-benefits-panel reveal reveal-delay-1">

            <h3>Need Help Choosing a Service?</h3>

            <p>
                Tell us about your building, lift system or project. Our
                team will help you identify the most suitable next step.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn">
                Request a Consultation
            </a>

        </div>

    </div>

</section>

<!-- ==========================================
     CALL TO ACTION
========================================== -->

<section class="cta reveal">

    <h2>Need Professional Lift Services?</h2>

    <p>
        Contact Almighty Lift Consultants to discuss installation,
        maintenance, repairs, modernisation or technical consulting.
    </p>

    <a asp-controller="Home"
       asp-action="Contact"
       class="btn">
        Contact Our Team
    </a>

</section>