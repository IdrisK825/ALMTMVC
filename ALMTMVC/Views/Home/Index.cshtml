@{
    ViewData["Title"] = "Home";
    ViewData["Description"] =
        "Professional lift installation, maintenance, repairs, modernisation and consulting services across South Africa.";
}

<!-- ==========================================
     HERO
========================================== -->

<section class="hero">

    <div class="hero-text">

        <h4>Welcome to Almighty Lift Consultants</h4>

        <h1>
            Engineering Reliable<br />
            Lift Solutions
        </h1>

        <p>
            From lift installation and preventative maintenance to
            modernisation, repairs and technical consulting, Almighty
            Lift Consultants delivers safe, dependable and cost-effective
            vertical transportation solutions for commercial, industrial
            and residential buildings throughout South Africa.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn">
                Request a Quote
            </a>

            <a asp-controller="Home"
               asp-action="Services"
               class="btn-secondary">
                Explore Services
            </a>

        </div>

    </div>

</section>

<!-- ==========================================
     COMPANY STATISTICS
========================================== -->

<section class="stats">

    <div class="stat">
        <h2>10+</h2>
        <p>Years of Experience</p>
    </div>

    <div class="stat">
        <h2>500+</h2>
        <p>Projects Completed</p>
    </div>

    <div class="stat">
        <h2>24/7</h2>
        <p>Emergency Support</p>
    </div>

    <div class="stat">
        <h2>100%</h2>
        <p>Commitment to Safety</p>
    </div>

</section>

<!-- ==========================================
     WHY CHOOSE US
========================================== -->

<section class="why-us">

    <span class="section-label">Why choose us</span>

    <h2>Professional Lift Solutions You Can Depend On</h2>

    <p class="section-subtitle">
        We combine technical expertise, quality workmanship and
        professional customer service to provide safe, reliable and
        efficient lift solutions.
    </p>

    <div class="features">

        <article class="feature-card">

            <div class="feature-icon" aria-hidden="true">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>Safety and Compliance</h3>

            <p>
                Our work follows applicable safety requirements,
                recognised industry practices and careful quality checks.
            </p>

        </article>

        <article class="feature-card">

            <div class="feature-icon" aria-hidden="true">
                <i class="fa-solid fa-gears"></i>
            </div>

            <h3>Technical Expertise</h3>

            <p>
                We provide professional lift installation, maintenance,
                repairs, modernisation and technical consulting.
            </p>

        </article>

        <article class="feature-card">

            
            <div class="feature-icon" aria-hidden="true">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <h3>Responsive Service</h3>

            <p>
                We understand the impact of lift downtime and respond
                professionally to service and repair enquiries.
            </p>

        </article>

        <article class="feature-card">

            <div class="feature-icon" aria-hidden="true">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>Customer Commitment</h3>

            <p>
                We value clear communication, dependable service and
                long-term relationships with our clients.
            </p>

        </article>

    </div>

</section>

<!-- ==========================================
     CALL TO ACTION
========================================== -->

<section class="cta">

    <h2>Ready to Discuss Your Lift Requirements?</h2>

    <p>
        Contact our team about new lift installations, servicing,
        repairs, modernisation or technical consulting.
    </p>

    <a asp-controller="Home"
       asp-action="Contact"
       class="btn">
        Contact Us
    </a>

</section>