@model ALMTMVC.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";

    int totalForChart = Math.Max(Model.TotalEnquiries, 1);

    double newPercent =
        Model.NewEnquiries * 100d / totalForChart;

    double contactedPercent =
        Model.ContactedEnquiries * 100d / totalForChart;

    double quotedPercent =
        Model.QuotedEnquiries * 100d / totalForChart;

    double completedPercent =
        Model.CompletedEnquiries * 100d / totalForChart;

    double closedPercent =
        Model.ClosedEnquiries * 100d / totalForChart;

    double spamPercent =
        Model.SpamEnquiries * 100d / totalForChart;

    double quotedStart =
        newPercent + contactedPercent;

    double completedStart =
        quotedStart + quotedPercent;

    double closedStart =
        completedStart + completedPercent;

    double spamStart =
        closedStart + closedPercent;

    string donutStyle = Model.TotalEnquiries == 0
        ? "background: conic-gradient(#e5e7eb 0 100%);"
        : $"background: conic-gradient(" +
          $"#f4b400 0 {newPercent:F2}%, " +
          $"#3b82f6 {newPercent:F2}% {quotedStart:F2}%, " +
          $"#8b5cf6 {quotedStart:F2}% {completedStart:F2}%, " +
          $"#22c55e {completedStart:F2}% {closedStart:F2}%, " +
          $"#6b7280 {closedStart:F2}% {spamStart:F2}%, " +
          $"#ef4444 {spamStart:F2}% 100%);";
}

<section class="admin-page">

    <div class="admin-page-header">

        <div>
            <span class="section-label">Administration</span>

            <h1>Enquiry Dashboard</h1>

            <p>
                Review and manage enquiries submitted through the
                Almighty Lift Consultants website.
            </p>
        </div>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home")"
              method="post"
              class="admin-logout-form">

            <button type="submit"
                    class="admin-secondary-button">

                <i class="fa-solid fa-right-from-bracket"
                   aria-hidden="true"></i>

                Sign Out
            </button>

        </form>

    </div>

    @if (TempData["AdminSuccess"] is string successMessage)
    {
        <div class="admin-alert admin-alert-success"
             role="alert">

            <i class="fa-solid fa-circle-check"
               aria-hidden="true"></i>

            @successMessage
        </div>
    }

    <!-- ==========================================
         SUMMARY CARDS
    =========================================== -->

    <div class="admin-summary-grid">

        <article class="admin-summary-card">

            <div class="admin-summary-icon">
                <i class="fa-solid fa-inbox"
                   aria-hidden="true"></i>
            </div>

            <div>
                <span>Total Enquiries</span>
                <strong>@Model.TotalEnquiries</strong>
            </div>

        </article>

        <article class="admin-summary-card">

            <div class="admin-summary-icon">
                <i class="fa-solid fa-envelope-open-text"
                   aria-hidden="true"></i>
            </div>

            <div>
                <span>New</span>
                <strong>@Model.NewEnquiries</strong>
            </div>

        </article>

        <article class="admin-summary-card">

            <div class="admin-summary-icon">
                <i class="fa-solid fa-phone"
                   aria-hidden="true"></i>
            </div>

            <div>
                <span>Contacted</span>
                <strong>@Model.ContactedEnquiries</strong>
            </div>

        </article>

        <article class="admin-summary-card">

            <div class="admin-summary-icon">
                <i class="fa-solid fa-circle-check"
                   aria-hidden="true"></i>
            </div>

            <div>
                <span>Completed</span>
                <strong>@Model.CompletedEnquiries</strong>
            </div>

        </article>

    </div>

    <!-- ==========================================
         DASHBOARD CHARTS
    =========================================== -->

    <section class="admin-charts-grid"
             aria-label="Enquiry statistics">

        <article class="admin-chart-card">

            <div class="admin-chart-heading">

                <div>
                    <span class="section-label">
                        Status Overview
                    </span>

                    <h2>Enquiries by Status</h2>

                    <p>
                        Distribution of all enquiries currently stored
                        in the database.
                    </p>
                </div>

                <div class="admin-chart-total">
                    <strong>@Model.TotalEnquiries</strong>
                    <span>Total</span>
                </div>

            </div>

            <div class="admin-status-chart">

                @foreach (var item in new[]
                {
                    new
                    {
                        Name = "New",
                        Count = Model.NewEnquiries,
                        Percent = newPercent,
                        ClassName = "chart-new"
                    },
                    new
                    {
                        Name = "Contacted",
                        Count = Model.ContactedEnquiries,
                        Percent = contactedPercent,
                        ClassName = "chart-contacted"
                    },
                    new
                    {
                        Name = "Quoted",
                        Count = Model.QuotedEnquiries,
                        Percent = quotedPercent,
                        ClassName = "chart-quoted"
                    },
                    new
                    {
                        Name = "Completed",
                        Count = Model.CompletedEnquiries,
                        Percent = completedPercent,
                        ClassName = "chart-completed"
                    },
                    new
                    {
                        Name = "Closed",
                        Count = Model.ClosedEnquiries,
                        Percent = closedPercent,
                        ClassName = "chart-closed"
                    },
                    new
                    {
                        Name = "Spam",
                        Count = Model.SpamEnquiries,
                        Percent = spamPercent,
                        ClassName = "chart-spam"
                    }
                })
                {
                    <div class="admin-chart-row">

                        <div class="admin-chart-label">

                            <span class="admin-chart-dot
                                @item.ClassName">
                            </span>

                            <span>@item.Name</span>

                            <strong>@item.Count</strong>

                        </div>

                        <div class="admin-chart-track"
                             aria-label="@item.Name enquiries:
                            @item.Count">

                            <span class="admin-chart-bar
                                @item.ClassName"
                                  style="width:
                                @item.Percent.ToString(
                                    "F2",
                                    System.Globalization
                                        .CultureInfo
                                        .InvariantCulture)%;">
                            </span>

                        </div>

                    </div>
                }

            </div>

        </article>

        <article class="admin-chart-card admin-donut-card">

            <div class="admin-chart-heading">

                <div>
                    <span class="section-label">
                        Workflow Snapshot
                    </span>

                    <h2>Status Distribution</h2>

                    <p>
                        A visual summary of where enquiries sit in
                        your workflow.
                    </p>
                </div>

            </div>

            <div class="admin-donut-layout">

                <div class="admin-donut-chart"
                     style="@donutStyle"
                     role="img"
                     aria-label="Enquiry status distribution">

                    <div class="admin-donut-centre">
                        <strong>@Model.TotalEnquiries</strong>
                        <span>Enquiries</span>
                    </div>

                </div>

                <div class="admin-chart-legend">

                    <div>
                        <span class="admin-chart-dot chart-new"></span>
                        New
                    </div>

                    <div>
                        <span class="admin-chart-dot chart-contacted"></span>
                        Contacted
                    </div>

                    <div>
                        <span class="admin-chart-dot chart-quoted"></span>
                        Quoted
                    </div>

                    <div>
                        <span class="admin-chart-dot chart-completed"></span>
                        Completed
                    </div>

                    <div>
                        <span class="admin-chart-dot chart-closed"></span>
                        Closed
                    </div>

                    <div>
                        <span class="admin-chart-dot chart-spam"></span>
                        Spam
                    </div>

                </div>

            </div>

            <div class="admin-weekly-stat">

                <div class="admin-weekly-icon">
                    <i class="fa-solid fa-calendar-week"
                       aria-hidden="true"></i>
                </div>

                <div>
                    <span>Received in the last 7 days</span>
                    <strong>@Model.EnquiriesLast7Days</strong>
                </div>

            </div>

        </article>

    </section>

    <!-- ==========================================
         ENQUIRY PANEL
    =========================================== -->

    <div class="admin-panel">

        <div class="admin-panel-header">

            <div class="admin-panel-title">

                <div>
                    <h2>Customer Enquiries</h2>

                    <p>
                        Showing @Model.FilteredEnquiries of
                        @Model.TotalEnquiries enquiries.
                    </p>
                </div>

            </div>

            <!-- ==========================================
                 SEARCH, FILTER AND EXPORT
            =========================================== -->

            <form asp-controller="Admin"
                  asp-action="Index"
                  method="get"
                  class="admin-filter-form">

                <div class="admin-search-field">

                    <label for="searchTerm">
                        Search enquiries
                    </label>

                    <div class="admin-search-input">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input id="searchTerm"
                               name="searchTerm"
                               type="search"
                               value="@Model.SearchTerm"
                               placeholder="Name, email, company, phone or service" />

                    </div>

                </div>

                <div class="admin-status-field">

                    <label for="statusFilter">
                        Status
                    </label>

                    <select id="statusFilter"
                            name="statusFilter">

                        <option value="">
                            All statuses
                        </option>

                        <option value="New"
                                selected="@(Model.StatusFilter == "New")">
                            New
                        </option>

                        <option value="Contacted"
                                selected="@(Model.StatusFilter == "Contacted")">
                            Contacted
                        </option>

                        <option value="Quoted"
                                selected="@(Model.StatusFilter == "Quoted")">
                            Quoted
                        </option>

                        <option value="Completed"
                                selected="@(Model.StatusFilter == "Completed")">
                            Completed
                        </option>

                        <option value="Closed"
                                selected="@(Model.StatusFilter == "Closed")">
                            Closed
                        </option>

                        <option value="Spam"
                                selected="@(Model.StatusFilter == "Spam")">
                            Spam
                        </option>

                    </select>

                </div>

                <div class="admin-filter-actions">

                    <button type="submit"
                            class="btn admin-filter-button">

                        <i class="fa-solid fa-filter"
                           aria-hidden="true"></i>

                        Apply
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Export"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-statusFilter="@Model.StatusFilter"
                       class="admin-export-button">

                        <i class="fa-solid fa-file-export"
                           aria-hidden="true"></i>

                        Export CSV
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) ||
                         !string.IsNullOrWhiteSpace(Model.StatusFilter))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="admin-clear-button">

                            <i class="fa-solid fa-xmark"
                               aria-hidden="true"></i>

                            Clear
                        </a>
                    }

                </div>

            </form>

        </div>

        <!-- ==========================================
             EMPTY STATE
        =========================================== -->
        @if (Model.Enquiries.Count == 0)
        {
            <div class="admin-empty-state">

                <i class="fa-solid fa-magnifying-glass"
                   aria-hidden="true"></i>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) ||
                     !string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <h3>No matching enquiries</h3>

                    <p>
                        Try changing your search term or selected status.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="admin-clear-button">

                        Clear Filters
                    </a>
                }
                else
                {
                    <h3>No enquiries yet</h3>

                    <p>
                        New contact-form submissions will appear here.
                    </p>
                }

            </div>
        }
        else
        {
            <!-- ==========================================
                 ENQUIRY TABLE
            =========================================== -->

            <div class="table-wrapper">

                <table class="data-table admin-data-table">

                    <thead>

                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var enquiry in Model.Enquiries)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @enquiry.FullName
                                    </strong>

                                    <span class="admin-table-secondary">
                                        @enquiry.Email
                                    </span>

                                </td>

                                <td>
                                    @enquiry.ServiceRequired
                                </td>

                                <td>
                                    @(enquiry.SubmittedAtUtc
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy HH:mm"))
                                </td>

                                <td>

                                    <span class="status-badge
                                        status-@enquiry.Status.ToLowerInvariant()">

                                        @enquiry.Status

                                    </span>

                                </td>

                                <td>

                                    <div class="admin-table-actions">

                                        <a asp-controller="Admin"
                                           asp-action="Details"
                                           asp-route-id="@enquiry.Id"
                                           class="admin-action-button">

                                            <i class="fa-solid fa-eye"
                                               aria-hidden="true"></i>

                                            View
                                        </a>

                                        <a href="mailto:@enquiry.Email"
                                           class="admin-action-button">

                                            <i class="fa-solid fa-envelope"
                                               aria-hidden="true"></i>

                                            Email
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>